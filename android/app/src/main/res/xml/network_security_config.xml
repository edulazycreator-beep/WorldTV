<?xml version="1.0" encoding="utf-8"?>
<!-- Many free-to-air broadcasters still serve HLS over plain HTTP, so cleartext is allowed. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
